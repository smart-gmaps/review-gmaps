# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # RAHASIA. Jangan diberi prefix NEXT_PUBLIC_.

# Google Maps Platform — Places API (New) harus diaktifkan di project GCP
GOOGLE_PLACES_API_KEY=your-google-places-api-key  # RAHASIA. Hanya dipakai di server.

# Dipakai untuk menyusun URL QR pada CSV export
NEXT_PUBLIC_SITE_URL=https://review-gmaps.vercel.app

# Salt untuk hashing IP di audit log (string acak apa saja, ganti nilainya)
IP_HASH_SALT=ganti-dengan-string-acak-panjang
